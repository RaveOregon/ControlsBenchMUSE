{
  "name": "controlsbench-muse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI-authored, closed-loop PLC testing workbench for the Meta Global AI Developer Hackathon.",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test test/proof-chassis.test.ts test/budget-guard.test.ts test/live-coordinator.test.ts test/campaign.test.ts test/m8-connector.test.ts test/portal-host.test.ts test/cdp-webvisu.test.ts test/m10-convergence.test.ts",
    "host": "node scripts/host-portal.js",
    "host:adaptive": "node scripts/host-portal.js --campaign fixture-adaptive",
    "host:m8": "powershell -ExecutionPolicy Bypass -File scripts/host-m8.ps1",
    "host:m8:preflight": "node scripts/host-portal.js --campaign m8 --preflight",
    "verify:convergence": "npm run typecheck && npm test && npm --prefix ui run typecheck && npm --prefix ui test && npm --prefix ui run build",
    "typecheck": "tsc --noEmit",
    "proof:m9": "npm run typecheck && npm test && node scripts/run-m9.js",
    "proof:m9:contracts": "node scripts/export-campaign-contract.js",
    "proof:m10:live": "powershell -ExecutionPolicy Bypass -File scripts/run-m10-live.ps1",
    "proof:m10:offline": "node scripts/check-m10-offline.js",
    "proof:m10:audit": "node scripts/audit-m10.js",
    "proof:m9:wonder": "node --env-file=.env scripts/run-m9-wonder.js",
    "proof:generate": "node --env-file=.env scripts/generate-world-package.js",
    "proof:repair": "node --env-file=.env scripts/repair-world-package.js",
    "proof:align-manifest": "node --env-file=.env scripts/align-world-manifest.js",
    "proof:repair-world": "node --env-file=.env scripts/repair-world-source.js",
    "proof:gate-a": "node scripts/run-gate-a.js",
    "proof:gate-b": "node scripts/run-gate-b.js",
    "proof:gate-c": "node --env-file=.env scripts/run-gate-c.js",
    "proof:gate-c:continue": "node scripts/continue-gate-c.js",
    "proof:gate-c:verify": "node scripts/continue-gate-c.js --verify-only",
    "proof:gate-d": "node scripts/run-gate-d.js",
    "proof:gate-d:review": "node --env-file=.env scripts/review-gate-d-with-muse.js",
    "proof:m7:live": "powershell -ExecutionPolicy Bypass -File scripts/run-m7-live.ps1",
    "proof:m7:audit": "node scripts/audit-m7.js",
    "spike:model": "node --env-file=.env scripts/run-model-spike.js"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
