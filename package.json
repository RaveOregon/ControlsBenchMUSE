{
  "name": "controlsbench-muse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI-authored, closed-loop PLC testing workbench for the Meta Global AI Developer Hackathon.",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test --test-concurrency=1 test/proof-chassis.test.ts test/budget-guard.test.ts test/live-coordinator.test.ts test/campaign.test.ts test/m8-connector.test.ts test/portal-host.test.ts test/cdp-webvisu.test.ts test/m10-convergence.test.ts test/machine-view.test.ts test/wonder-campaign.test.ts test/wonder-portal.test.ts test/wonder-factory.test.ts test/wonder-scope.test.ts test/wonder-recorded-browser.test.ts test/wonder-paid-replay.test.ts",
    "host": "node scripts/host-portal.js",
    "host:adaptive": "node scripts/host-portal.js --campaign fixture-adaptive",
    "host:m8": "powershell -ExecutionPolicy Bypass -File scripts/host-m8.ps1",
    "host:m8:preflight": "node scripts/host-portal.js --campaign m8 --preflight",
    "verify:convergence": "node scripts/check-m10-convergence.js",
    "proof:convergence:view": "node scripts/check-m10-portal-view.js",
    "typecheck": "tsc --noEmit",
    "proof:m9": "npm run typecheck && npm test && node scripts/run-m9.js",
    "proof:m9:contracts": "node scripts/export-campaign-contract.js",
    "proof:m10:live": "powershell -ExecutionPolicy Bypass -File scripts/run-m10-live.ps1",
    "proof:m10:offline": "node scripts/check-m10-offline.js",
    "proof:m10:audit": "node scripts/audit-m10.js",
    "proof:m9:wonder": "node --env-file=.env scripts/run-m9-wonder.js",
    "proof:view": "node scripts/build-machine-view-contract.js --check && node --test test/machine-view.test.ts && tsc -p tsconfig.portal-check.json",
    "proof:view:contract": "node scripts/build-machine-view-contract.js",
    "proof:view:browser": "node scripts/check-machine-view-browser.js --package",
    "view:preview": "node scripts/preview-machine-view.js --open",
    "proof:view:wonder": "node --env-file=.env scripts/generate-machine-view.js",
    "proof:view:audit": "node scripts/audit-machine-view.js",
    "proof:view:refine": "node --env-file=.env scripts/refine-machine-view.js",
    "proof:generate": "node --env-file=.env scripts/generate-world-package.js",
    "proof:repair": "node --env-file=.env scripts/repair-world-package.js",
    "proof:align-manifest": "node --env-file=.env scripts/align-world-manifest.js",
    "proof:repair-world": "node --env-file=.env scripts/repair-world-source.js",
    "proof:gate-a": "node scripts/run-gate-a.js",
    "proof:gate-b": "node scripts/run-gate-b.js",
    "proof:gate-c": "node --env-file=.env scripts/run-gate-c.js",
    "proof:gate-c:continue": "node scripts/continue-gate-c.js",
    "proof:gate-c:verify": "node scripts/continue-gate-c.js --verify-only",
    "proof:gate-d": "node scripts/run-gate-d.js",
    "proof:gate-d:review": "node --env-file=.env scripts/review-gate-d-with-muse.js",
    "proof:m7:live": "powershell -ExecutionPolicy Bypass -File scripts/run-m7-live.ps1",
    "proof:m7:audit": "node scripts/audit-m7.js",
    "spike:model": "node --env-file=.env scripts/run-model-spike.js",
    "proof:wonder": "node scripts/verify-wonder.js",
    "host:wonder:recorded": "node scripts/host-portal.js --campaign-module src/host/wonder-recorded-factory.ts --artifacts artifacts/wonder-portal",
    "proof:wonder:checkpoint": "node scripts/run-wonder-checkpoint.js",
    "host:wonder": "node scripts/host-portal.js --campaign-module src/host/wonder-campaign-factory.ts --artifacts artifacts/wonder-portal",
    "proof:wonder:portal": "node scripts/check-wonder-portal.js"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
