{
  "assumptions": [
    "Geometry, drive delays, ramp, encoder counts/m are inferred demo configuration, not PLC thresholds.",
    "No PLC detection/jam/debounce deadlines are assumed; they remain TBD."
  ],
  "capabilities": {
    "migrate": true,
    "seededRandom": true,
    "snapshot": true
  },
  "controls": [
    {
      "description": "Introduce a carton at entry. Payload { itemId?, requestedRoute?: 'A'|'B'|'Unknown'|null }.",
      "id": "carton.introduce"
    },
    {
      "description": "Set downstream readiness { destination: 'A'|'B'|'runout', ready: boolean }.",
      "id": "downstream.setReady"
    },
    {
      "description": "Suppress actual drive running feedback { active }.",
      "id": "fault.setDriveFeedbackFailure"
    },
    {
      "description": "Assert/clear drive overload { active }.",
      "id": "fault.setOverload"
    },
    {
      "description": "Jam/free a divert { divert: 1|2, active }.",
      "id": "fault.setDivertJam"
    },
    {
      "description": "Force both limits true { divert: 1|2, active }.",
      "id": "fault.setContradictoryLimits"
    },
    {
      "description": "Hold a photoeye stuck { signalId, active, value? }.",
      "id": "fault.setSensorStuck"
    },
    {
      "description": "Bounce a photoeye { signalId, durationMs? }.",
      "id": "fault.setSensorBounce"
    },
    {
      "description": "Jam a carton in place { cartonId?, active }.",
      "id": "fault.setCartonJam"
    },
    {
      "description": "Clear all faults and restore readiness.",
      "id": "fault.clearAll"
    }
  ],
  "evidenceTypes": [
    "world.initialized",
    "world.disposed",
    "carton.introduced",
    "carton.introductionRejected",
    "carton.diverted",
    "carton.exited",
    "fault.injected",
    "fault.cleared",
    "downstream.readinessChanged",
    "drive.stateChanged",
    "divert.limitReached"
  ],
  "faultCapabilities": [
    "drive.feedbackFailure",
    "drive.overloadTrip",
    "divert1.jam",
    "divert2.jam",
    "divert1.contradictoryLimits",
    "divert2.contradictoryLimits",
    "sensor.stuck",
    "sensor.bounce",
    "carton.jam",
    "downstream.blocked"
  ],
  "inspectableState": [
    "cartons",
    "drive",
    "divert1",
    "divert2",
    "encoder",
    "downstream",
    "faults",
    "completedCartons"
  ],
  "name": "Conveyor Bench — Demo Baseline",
  "packageVersion": "0.5.0",
  "signals": [
    {
      "dataType": "BOOL",
      "description": "PLC command to belt drive.",
      "deviceId": "drive",
      "direction": "plc_to_world",
      "id": "Motor_RunCmd",
      "name": "Motor_RunCmd",
      "normalValue": false,
      "role": "drive.runCommand"
    },
    {
      "dataType": "BOOL",
      "description": "Extend divert 1 to exit A; deassert returns home.",
      "deviceId": "divert1",
      "direction": "plc_to_world",
      "id": "D1_ExtendCmd",
      "name": "D1_ExtendCmd",
      "normalValue": false,
      "role": "divert1.extendCommand"
    },
    {
      "dataType": "BOOL",
      "description": "Extend divert 2 to exit B; deassert returns home.",
      "deviceId": "divert2",
      "direction": "plc_to_world",
      "id": "D2_ExtendCmd",
      "name": "D2_ExtendCmd",
      "normalValue": false,
      "role": "divert2.extendCommand"
    },
    {
      "dataType": "BOOL",
      "description": "Optional fault indication; observed only.",
      "deviceId": "stackLight",
      "direction": "plc_to_world",
      "id": "StackLight_Red",
      "name": "StackLight_Red",
      "normalValue": false,
      "role": "indication.stackRed"
    },
    {
      "dataType": "BOOL",
      "description": "Optional running/ready indication; observed only.",
      "deviceId": "stackLight",
      "direction": "plc_to_world",
      "id": "StackLight_Green",
      "name": "StackLight_Green",
      "normalValue": false,
      "role": "indication.stackGreen"
    },
    {
      "dataType": "BOOL",
      "description": "Carton blocks entry beam.",
      "deviceId": "peEntry",
      "direction": "world_to_plc",
      "id": "PE_Entry",
      "name": "PE_Entry",
      "normalValue": false,
      "role": "sensor.entry"
    },
    {
      "dataType": "BOOL",
      "description": "Carton in divert 1 decision window.",
      "deviceId": "peD1Approach",
      "direction": "world_to_plc",
      "id": "PE_D1Approach",
      "name": "PE_D1Approach",
      "normalValue": false,
      "role": "sensor.d1Approach"
    },
    {
      "dataType": "BOOL",
      "description": "Carton on main lane toward divert 2.",
      "deviceId": "peD2Approach",
      "direction": "world_to_plc",
      "id": "PE_D2Approach",
      "name": "PE_D2Approach",
      "normalValue": false,
      "role": "sensor.d2Approach"
    },
    {
      "dataType": "BOOL",
      "description": "Carton passes exit A.",
      "deviceId": "peExitA",
      "direction": "world_to_plc",
      "id": "PE_ExitA",
      "name": "PE_ExitA",
      "normalValue": false,
      "role": "sensor.exitA"
    },
    {
      "dataType": "BOOL",
      "description": "Carton passes exit B.",
      "deviceId": "peExitB",
      "direction": "world_to_plc",
      "id": "PE_ExitB",
      "name": "PE_ExitB",
      "normalValue": false,
      "role": "sensor.exitB"
    },
    {
      "dataType": "BOOL",
      "description": "Carton passes runout.",
      "deviceId": "peRunout",
      "direction": "world_to_plc",
      "id": "PE_Runout",
      "name": "PE_Runout",
      "normalValue": false,
      "role": "sensor.runout"
    },
    {
      "dataType": "BOOL",
      "description": "Divert 1 fully home.",
      "deviceId": "divert1",
      "direction": "world_to_plc",
      "id": "D1_HomeFB",
      "name": "D1_HomeFB",
      "normalValue": true,
      "role": "divert1.homeFeedback"
    },
    {
      "dataType": "BOOL",
      "description": "Divert 1 fully extended.",
      "deviceId": "divert1",
      "direction": "world_to_plc",
      "id": "D1_ExtendedFB",
      "name": "D1_ExtendedFB",
      "normalValue": false,
      "role": "divert1.extendedFeedback"
    },
    {
      "dataType": "BOOL",
      "description": "Divert 2 fully home.",
      "deviceId": "divert2",
      "direction": "world_to_plc",
      "id": "D2_HomeFB",
      "name": "D2_HomeFB",
      "normalValue": true,
      "role": "divert2.homeFeedback"
    },
    {
      "dataType": "BOOL",
      "description": "Divert 2 fully extended.",
      "deviceId": "divert2",
      "direction": "world_to_plc",
      "id": "D2_ExtendedFB",
      "name": "D2_ExtendedFB",
      "normalValue": false,
      "role": "divert2.extendedFeedback"
    },
    {
      "dataType": "BOOL",
      "description": "Actual drive-running feedback, delayed and suppressible.",
      "deviceId": "drive",
      "direction": "world_to_plc",
      "id": "Drive_RunningFB",
      "name": "Drive_RunningFB",
      "normalValue": false,
      "role": "drive.runningFeedback"
    },
    {
      "dataType": "BOOL",
      "description": "Simulated overload/trip; normally false.",
      "deviceId": "drive",
      "direction": "world_to_plc",
      "id": "Drive_Overload",
      "name": "Drive_Overload",
      "normalValue": false,
      "role": "drive.overload"
    },
    {
      "dataType": "BOOL",
      "description": "Destination A can accept a carton.",
      "deviceId": "exitA",
      "direction": "world_to_plc",
      "id": "ExitA_Ready",
      "name": "ExitA_Ready",
      "normalValue": true,
      "role": "destination.exitAReady"
    },
    {
      "dataType": "BOOL",
      "description": "Destination B can accept a carton.",
      "deviceId": "exitB",
      "direction": "world_to_plc",
      "id": "ExitB_Ready",
      "name": "ExitB_Ready",
      "normalValue": true,
      "role": "destination.exitBReady"
    },
    {
      "dataType": "BOOL",
      "description": "Runout can accept a carton.",
      "deviceId": "runout",
      "direction": "world_to_plc",
      "id": "Runout_Ready",
      "name": "Runout_Ready",
      "normalValue": true,
      "role": "destination.runoutReady"
    },
    {
      "dataType": "REAL",
      "description": "Diagnostic belt speed m/s.",
      "deviceId": "drive",
      "direction": "world_to_plc",
      "id": "Belt_SpeedActual",
      "name": "Belt_SpeedActual",
      "normalValue": 0,
      "role": "diagnostic.beltSpeedActual"
    },
    {
      "dataType": "REAL",
      "description": "Diagnostic drive current A.",
      "deviceId": "drive",
      "direction": "world_to_plc",
      "id": "Drive_Current",
      "name": "Drive_Current",
      "normalValue": 0,
      "role": "diagnostic.driveCurrent"
    },
    {
      "dataType": "REAL",
      "description": "Divert 1 position 0-100%.",
      "deviceId": "divert1",
      "direction": "world_to_plc",
      "id": "D1_Position",
      "name": "D1_Position",
      "normalValue": 0,
      "role": "diagnostic.divert1Position"
    },
    {
      "dataType": "REAL",
      "description": "Divert 2 position 0-100%.",
      "deviceId": "divert2",
      "direction": "world_to_plc",
      "id": "D2_Position",
      "name": "D2_Position",
      "normalValue": 0,
      "role": "diagnostic.divert2Position"
    },
    {
      "dataType": "UDINT",
      "description": "Encoder count from physical belt motion; 1000/m, floored, wraps modulo 2^32.",
      "deviceId": "encoder",
      "direction": "world_to_plc",
      "id": "Encoder_Count",
      "name": "Encoder_Count",
      "normalValue": 0,
      "role": "motion.encoderCount"
    }
  ],
  "stateSchemaVersion": "1.0.0",
  "tickMs": 20,
  "worldId": "conveyor-demo-baseline"
}
