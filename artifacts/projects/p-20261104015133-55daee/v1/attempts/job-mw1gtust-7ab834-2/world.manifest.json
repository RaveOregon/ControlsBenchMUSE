{
  "assumptions": [
    "Belt speed 0.30 m/s is specified in spec section 2; geometry, acceleration, encoder density and feedback delay are inferred and labelled in assumptions.md.",
    "Cartons follow the actual divert position at the decision point; route assignment, counting and misroute judgement are PLC logic and are not modelled."
  ],
  "capabilities": {
    "migrate": true,
    "seededRandom": true,
    "snapshot": true
  },
  "controls": [
    {
      "description": "Introduce a physical carton at the entry (position 0). Payload may carry id/itemId; route is ignored by the physics.",
      "id": "carton.introduce"
    },
    {
      "description": "Set downstream readiness. Payload: exit/destination/signalId (A, B or Runout) and ready/value boolean.",
      "id": "downstream.setReady"
    },
    {
      "description": "Drive produces no running state/feedback while active; belt does not move. Payload: active/value boolean.",
      "id": "fault.setDriveFeedbackFailure"
    },
    {
      "description": "Assert Drive_Overload and trip the physical drive while active. Payload: active/value boolean.",
      "id": "fault.setOverload"
    },
    {
      "description": "Freeze a divert actuator (D1, D2, or both if unspecified). Payload: divert/divertId, active/value.",
      "id": "fault.setDivertJam"
    },
    {
      "description": "Force home and extended feedback simultaneously on D1, D2, or both. Payload: divert/divertId, active/value.",
      "id": "fault.setContradictoryLimits"
    },
    {
      "description": "Hold a boolean input at a fixed value despite physics. Payload: signalId/sensor, value, active.",
      "id": "fault.setSensorStuck"
    },
    {
      "description": "Toggle a boolean input on alternate ticks. Payload: signalId/sensor, active.",
      "id": "fault.setSensorBounce"
    },
    {
      "description": "Hold cartons stationary while the belt runs. Payload: active/value boolean.",
      "id": "fault.setCartonJam"
    },
    {
      "description": "Clear all injected faults (drive, overload, jams, contradictory limits, stuck/bounce sensors).",
      "id": "fault.clearAll"
    }
  ],
  "evidenceTypes": [
    "world-event",
    "carton-introduced",
    "carton-removed",
    "control-applied",
    "fault-cleared"
  ],
  "faultCapabilities": [
    "fault.setDriveFeedbackFailure",
    "fault.setOverload",
    "fault.setDivertJam",
    "fault.setContradictoryLimits",
    "fault.setSensorStuck",
    "fault.setSensorBounce",
    "fault.setCartonJam",
    "fault.clearAll"
  ],
  "inspectableState": [
    "cartons",
    "beltSpeedMps",
    "totalTravelM",
    "encoderCount",
    "d1PositionPct",
    "d2PositionPct",
    "downstreamReady",
    "faults"
  ],
  "name": "Slow-belt conveyor variant (M8)",
  "packageVersion": "1.0.2",
