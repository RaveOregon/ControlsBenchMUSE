{
  "schemaVersion": "controlsbench.campaign.v1",
  "decision": {
    "type": "object",
    "properties": {
      "summary": {
        "type": "string",
        "minLength": 1,
        "maxLength": 8000
      },
      "reasoningLease": {
        "type": "object",
        "properties": {
          "mode": {
            "enum": [
              "hold",
              "continue",
              "condition_deadline"
            ]
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 300000
          },
          "condition": {
            "type": "object",
            "properties": {
              "signal": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8000
              },
              "equals": {
                "type": [
                  "boolean",
                  "number",
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "signal",
              "equals"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "mode",
          "timeoutMs"
        ],
        "additionalProperties": false
      },
      "plan": {
        "type": "object",
        "properties": {
          "objective": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "experiments": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8000
                },
                "objective": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8000
                },
                "category": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8000
                },
                "requirements": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8000
                  },
                  "minItems": 0,
                  "maxItems": 200
                }
              },
              "required": [
                "id",
                "objective",
                "category",
                "requirements"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 40
          }
        },
        "required": [
          "objective",
          "experiments"
        ],
        "additionalProperties": false
      },
      "completeExperiment": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8000
            },
            "minItems": 1,
            "maxItems": 200
          },
          "conclusion": {
            "enum": [
              "observed",
              "inconclusive"
            ]
          }
        },
        "required": [
          "id",
          "evidenceRefs",
          "conclusion"
        ],
        "additionalProperties": false
      },
      "calls": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8000
            },
            "name": {
              "enum": [
                "inspect_spec",
                "inspect_signal_contract",
                "inspect_recent_evidence",
                "inspect_evidence_window",
                "introduce_carton",
                "assign_route",
                "operator_action",
                "acknowledge_completion",
                "set_downstream_readiness",
                "inject_fault",
                "clear_fault",
                "wait_for_condition",
                "observe_for_duration",
                "branch_or_reset_world",
                "request_hmi_action",
                "capture_hmi_evidence",
                "record_hmi_assessment",
                "create_followup_experiment",
                "record_finding",
                "finish_campaign"
              ]
            },
            "arguments": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "required": [
            "id",
            "name",
            "arguments"
          ],
          "additionalProperties": false
        },
        "minItems": 0,
        "maxItems": 8
      }
    },
    "required": [
      "summary",
      "calls"
    ],
    "additionalProperties": false
