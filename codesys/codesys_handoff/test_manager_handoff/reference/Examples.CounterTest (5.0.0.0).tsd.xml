def get_online_device(device_object_name):
    try:
        from scriptengine import online, projects
    except:
        raise Exception ("get online_device requires option LoadScriptDrivers") 
    # Get open project
    proj = projects.primary
    found = proj.find(device_object_name)
    assert len(found) &gt; 0 and found[0].is_device, "Device '" + device_object_name + "' not found"
    dev = found[0]

    online_device = online.create_online_device(dev)
    assert online_device, "no online device"

    return online_device



msg=""
"""
:param device_object_name: Name in device tree for which the password change should executed
:param user_name: name for the default user 
:param pwd: password to set for User
"""
# set default credentials for login
online.set_default_credentials(user_name, pwd)

print ("get online device")
online_device = get_online_device(DeviceName)

print ("set initial user")
online_device.set_credentials_for_initial_user(user_name, pwd)

retries = 5
print ("connect to device")
for loop in range(0, retries):
    try:
        online_device.connect()
        # if successful go further
        print ("connection to online device successful")
        break
    except Exception as e:
        print(e)
        if "Device is not ready yet" in str(e):
            print ("wait 20s and try to reconnect, Retries:" + str(loop))
            sleep(20)
        else:
            # all other exception stop retry
            break

actual_user = online_device.current_logged_on_username
if actual_user != user_name:
    print "the configured user (" + user_name + ") is not logged in / maybe user management is not activated actual user: " + actual_user
else: 
    print("connection successfull with user: " + actual_user)
# disconnect from device
online_device.disconnect()</Entry>
