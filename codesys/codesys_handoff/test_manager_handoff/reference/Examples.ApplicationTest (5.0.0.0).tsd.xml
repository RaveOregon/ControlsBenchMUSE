print ("set initial user")
online_device.set_credentials_for_initial_user(user_name, pwd)

retries = 5
print ("connect to device")
for loop in range(0, retries):
    try:
        online_device.connect()
        # if successful go further
        print ("connection to online device successful")
        break
    except Exception as e:
        print(e)
        if "Device is not ready yet" in str(e):
            print ("wait 20s and try to reconnect, Retries:" + str(loop))
            sleep(20)
        else:
            # all other exception stop retry
            break

actual_user = online_device.current_logged_on_username
if actual_user != user_name:
    print "the configured user (" + user_name + ") is not logged in / maybe user management is not activated actual user: " + actual_user
else: 
    print("connection successfull with user: " + actual_user)
# disconnect from device
online_device.disconnect()</Entry>
