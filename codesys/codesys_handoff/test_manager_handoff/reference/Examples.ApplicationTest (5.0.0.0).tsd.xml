def get_online_device(device_object_name):
    try:
        from scriptengine import online, projects
    except:
        raise Exception ("get online_device requires option LoadScriptDrivers") 
    # Get open project
    proj = projects.primary
    found = proj.find(device_object_name)
    assert len(found) &gt; 0 and found[0].is_device, "Device '" + device_object_name + "' not found"
    dev = found[0]

    online_device = online.create_online_device(dev)
    assert online_device, "no online device"

    return online_device



