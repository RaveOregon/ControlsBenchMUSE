{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["src/proof/**/*.ts", "src/live/**/*.ts", "src/campaign/**/*.ts", "src/host/**/*.ts", "src/machine-view/**/*.ts", "test/**/*.ts"]
}
